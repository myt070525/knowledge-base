# 默认按文本处理，仓库内统一使用 LF
* text=auto eol=lf

# 明确的文本类型
*.md      text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.xml     text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.ts      text eol=lf
*.py      text eol=lf
*.java    text eol=lf
*.sql     text eol=lf
*.ps1     text eol=crlf

# Windows 批处理必须保留 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 二进制文件不做换行转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.docx    binary
*.xlsx    binary
*.pptx    binary
*.zip     binary

# 语言统计与 diff
*.md      linguist-documentation
